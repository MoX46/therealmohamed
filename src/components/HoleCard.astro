---
import HoleIcon from './HoleIcon.astro';
import StatusBadge from './StatusBadge.astro';
import { formatDate, type Hole, type Project } from '../lib/content';

interface Props {
  /** A rabbit hole or a project. */
  hole: Hole | Project;
  /** The section it lives in. */
  base?: '/rabbit-holes/' | '/projects/';
  updateCount?: number;
  latest?: Date;
  variant?: 'feature' | 'compact';
}

const { hole, base = '/rabbit-holes/', updateCount = 0, latest, variant = 'compact' } = Astro.props;
const { title, blurb, status, icon } = hole.data;
const statusLabel = hole.data.statusLabel ?? (base === '/projects/' && status === 'done' ? 'Done' : undefined);
const href = `${base}${hole.id}/`;
---

{
  variant === 'feature' ? (
    <a href={href} class="card card--feature">
      <div class="card-top">
        <HoleIcon name={icon} />
        <span class="chips">
          {hole.data.draft && <span class="tag">Draft</span>}
          <StatusBadge status={status} label={statusLabel} />
        </span>
      </div>
      <h3>{title}</h3>
      <p>{blurb}</p>
      {latest && (
        <span class="mono">
          Latest: {formatDate(latest)} · {updateCount} {updateCount === 1 ? 'update' : 'updates'}
        </span>
      )}
    </a>
  ) : (
    <a href={href} class="card">
      <span class="chips">
        <StatusBadge status={status} label={statusLabel} />
        {hole.data.draft && <span class="tag">Draft</span>}
      </span>
      <h3>{title}</h3>
      <p>{blurb}</p>
    </a>
  )
}
