---
import { Image } from 'astro:assets';
import type { Book } from '../lib/content';

// Covers are either a photo in the repo or a link to the Goodreads cover.
const { cover } = Astro.props as { cover: Book['data']['cover'] };
---

{
  !cover ? (
    <span class="spine" />
  ) : typeof cover === 'string' ? (
    <img src={cover} alt="" class="spine" width="56" loading="lazy" decoding="async" referrerpolicy="no-referrer" />
  ) : (
    <Image src={cover} alt="" class="spine" width={112} />
  )
}
