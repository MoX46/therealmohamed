---
import Base from '../layouts/Base.astro';
import HoleCard from '../components/HoleCard.astro';
import BookCover from '../components/BookCover.astro';
import { SITE } from '../site';
import { bookHref, formatDate, getBooks, getFeed, getHoles, getProjects, getThoughts, readingTime } from '../lib/content';

const holes = await getHoles();
const featured = holes.filter((h) => h.hole.data.featured);
const current = (featured.length ? featured : holes.filter((h) => h.hole.data.status === 'active')).slice(0, 3);
// Featured projects, or else the latest ones: in progress first, then waiting, then done.
const projects = await getProjects();
const featuredProjects = projects.filter((p) => p.project.data.featured);
const shownProjects = (featuredProjects.length ? featuredProjects : projects).slice(0, 3);
const feed = await getFeed(4);
const books = (await getBooks()).filter((b) => b.data.status !== 'want').slice(0, 4);
const thoughts = (await getThoughts()).slice(0, 4);
---

<Base>
  <section class="hero">
    <p class="mono" style="margin: 0 0 20px; font-size: 14px">Hi, I'm {SITE.author}.</p>
    <h1>I get <span class="mark">really</span> into things.</h1>
    <p class="lede">
      I always find myself picking up a new hobby or project and getting completely obsessed. These are my
      notes from the deep end.
    </p>
  </section>

  <section class="section">
    <div class="section-head">
      <h2>Rabbit holes</h2>
      <a href="/rabbit-holes/">See all {holes.length} →</a>
    </div>
    {
      holes.length === 0 ? (
        <p class="empty">The first rabbit holes are being written up: chess, a Rubik's cube, a new role. Check back soon.</p>
      ) : (
        <div class="grid-feature">
          {current.map(({ hole, updates, latest }) => (
            <HoleCard hole={hole} variant="feature" updateCount={updates.length} latest={latest} />
          ))}
        </div>
      )
    }
  </section>

  {
    projects.length > 0 && (
      <section class="section">
        <div class="section-head">
          <h2>Projects</h2>
          <a href="/projects/">See all {projects.length} →</a>
        </div>
        <div class="grid-feature">
          {shownProjects.map(({ project, updates, latest }) => (
            <HoleCard hole={project} base="/projects/" variant="feature" updateCount={updates.length} latest={latest} />
          ))}
        </div>
      </section>
    )
  }

  <section class="panels panels--home section">
    <div class="panel">
      <div class="section-head">
        <h2>Bookshelf</h2>
        <a href="/bookshelf/">All books →</a>
      </div>
      {
        books.length === 0 ? (
          <p class="mono">Nothing logged yet.</p>
        ) : (
          books.map((book) => (
            <a href={bookHref(book)} class="book-row" style="text-decoration: none">
              <BookCover cover={book.data.cover} />
              <span style="display: flex; flex-direction: column; gap: 3px">
                <span class="title">{book.data.title}</span>
                {book.data.take && <span class="take">“{book.data.take}”</span>}
                <span class="mono">
                  {book.data.author}
                  {book.data.status === 'reading' ? ' · reading now' : ''}
                  {book.data.rating ? ` · ${'★'.repeat(book.data.rating)}${'☆'.repeat(5 - book.data.rating)}` : ''}
                </span>
              </span>
            </a>
          ))
        )
      }
    </div>

    <div class="panel panel--dark thoughts-panel" data-thoughts>
      <div class="section-head">
        <h2>Thoughts</h2>
        <a href="/thoughts/">All thoughts →</a>
      </div>
      {
        thoughts.length === 0 ? (
          <p class="mono">Coming soon.</p>
        ) : (
          <>
            <span class="quote-mark" aria-hidden="true">“</span>
            <div class="thought-slides">
              {thoughts.map((t, i) => (
                <a href={`/thoughts/${t.id}/`} class="thought-slide" data-slide hidden={i !== 0}>
                  <span class="q">{t.data.description ?? t.data.title}</span>
                  <span class="mono">
                    {formatDate(t.data.date)} · {readingTime(t.body)}
                  </span>
                </a>
              ))}
            </div>
            {thoughts.length > 1 && (
              <ol class="thought-index">
                {thoughts.map((t, i) => (
                  <li>
                    <button type="button" data-pick={i} aria-pressed={i === 0 ? 'true' : 'false'}>
                      <span class="mono">{String(i + 1).padStart(2, '0')}</span>
                      <span>{t.data.title}</span>
                    </button>
                  </li>
                ))}
              </ol>
            )}
          </>
        )
      }
    </div>
  </section>

  {
    feed.length > 0 && (
      <section class="section feed--small">
        <h2 class="mono">Latest updates</h2>
        <div class="feed">
          {feed.map((item) => (
            <a href={item.href}>
              <span class="mono when">{formatDate(item.date)}</span>
              <span class="mono where">{item.where}</span>
              <span class="what">{item.text}</span>
            </a>
          ))}
        </div>
      </section>
    )
  }
</Base>

<script>
  // Clicking a title in the Thoughts index swaps that thought into the spotlight.
  document.querySelectorAll<HTMLElement>('[data-thoughts]').forEach((panel) => {
    const slides = [...panel.querySelectorAll<HTMLElement>('[data-slide]')];
    const picks = [...panel.querySelectorAll<HTMLButtonElement>('[data-pick]')];
    picks.forEach((pick, i) =>
      pick.addEventListener('click', () => {
        slides.forEach((slide, j) => (slide.hidden = j !== i));
        picks.forEach((p, j) => p.setAttribute('aria-pressed', String(j === i)));
      }),
    );
  });
</script>
