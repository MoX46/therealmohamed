---
import { Image } from 'astro:assets';
import Base from '../layouts/Base.astro';
import HoleCard from '../components/HoleCard.astro';
import { SITE } from '../site';
import {
  bookHref,
  formatDate,
  getBooks,
  getFeed,
  getHoles,
  getThoughts,
  GENRES,
  readingTime,
} from '../lib/content';

const holes = await getHoles();
const featured = holes.filter((h) => h.hole.data.featured);
const current = (featured.length ? featured : holes.filter((h) => h.hole.data.status === 'active')).slice(0, 3);
const feed = await getFeed(6);
const books = (await getBooks()).filter((b) => b.data.status !== 'want').slice(0, 3);
const [thought] = await getThoughts();
const updatedAt = feed[0]?.date;
---

<Base>
  <section class="hero">
    <p class="mono" style="margin: 0 0 20px; font-size: 14px">Hi, I'm {SITE.author}.</p>
    <h1>I get <span class="mark">really</span> into things.</h1>
    <p class="lede">
      This is where I keep track of my rabbit holes: chess, cubes, cabinets, books, and whatever grabs me
      next. Some I finish, some I pause, and every one of them teaches me something.
    </p>
  </section>

  {
    current.length > 0 && (
      <section class="section">
        <div class="section-head">
          <h2>Currently into</h2>
          {updatedAt && <span class="mono">updated {formatDate(updatedAt, 'month')}</span>}
        </div>
        <div class="grid-feature">
          {current.map(({ hole, updates, latest }) => (
            <HoleCard hole={hole} variant="feature" updateCount={updates.length} latest={latest} />
          ))}
        </div>
      </section>
    )
  }

  <section class="section">
    <div class="section-head">
      <h2>All rabbit holes</h2>
      <a href="/rabbit-holes/">See all →</a>
    </div>
    {
      holes.length === 0 ? (
        <p class="empty">The first rabbit holes are being written up: chess, a Rubik's cube, some very repainted kitchen cabinets. Check back soon.</p>
      ) : (
        <div class="grid-compact">
          {holes.map(({ hole }) => (
            <HoleCard hole={hole} />
          ))}
        </div>
      )
    }
  </section>

  {
    feed.length > 0 && (
      <section class="section">
        <div class="section-head">
          <h2>Latest updates</h2>
        </div>
        <div class="feed">
          {feed.map((item) => (
            <a href={item.href}>
              <span class="mono when">{formatDate(item.date)}</span>
              <span class="mono where">{item.where}</span>
              <span class="what">{item.text}</span>
            </a>
          ))}
        </div>
      </section>
    )
  }

  <section class="panels">
    <div class="panel">
      <div class="section-head">
        <h2>On the bookshelf</h2>
        <a href="/bookshelf/">All books →</a>
      </div>
      {
        books.length === 0 ? (
          <p class="mono">Nothing logged yet.</p>
        ) : (
          books.map((book) => (
            <a href={bookHref(book)} class="book-row" style="text-decoration: none">
              {book.data.cover ? (
                <Image src={book.data.cover} alt="" class="spine" width={88} />
              ) : (
                <span class="spine" />
              )}
              <span style="display: flex; flex-direction: column; gap: 2px">
                <span class="title">{book.data.title}</span>
                <span class="mono">
                  {GENRES[book.data.genre]}
                  {book.data.status === 'reading' ? ' · reading now' : ''}
                  {book.data.rating ? ` · ${'★'.repeat(book.data.rating)}${'☆'.repeat(5 - book.data.rating)}` : ''}
                </span>
              </span>
            </a>
          ))
        )
      }
    </div>

    <div class="panel panel--dark">
      <div class="section-head">
        <h2>A recent thought</h2>
        <a href="/thoughts/">All thoughts →</a>
      </div>
      {
        thought ? (
          <>
            <p class="pullquote">
              <a href={`/thoughts/${thought.id}/`}>{thought.data.description ?? thought.data.title}</a>
            </p>
            <span class="mono">
              {thought.data.title} · {readingTime(thought.body)}
            </span>
          </>
        ) : (
          <p class="mono">Coming soon.</p>
        )
      }
    </div>
  </section>
</Base>
