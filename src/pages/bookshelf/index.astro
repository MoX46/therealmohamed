---
import BookCover from '../../components/BookCover.astro';
import ExternalIcon from '../../components/ExternalIcon.astro';
import Base from '../../layouts/Base.astro';
import { SITE } from '../../site';
import { bookHref, formatDate, GENRES, getBooks, hasSummary } from '../../lib/content';

const books = await getBooks();
const genres = Object.entries(GENRES).filter(([key]) => books.some((b) => b.data.genre === key));
const STATUS = { reading: 'Reading now', read: 'Read', want: 'Want to read' } as const;
// A book counts as reviewed when you've written a one-line take or a summary for it.
const isReviewed = (book: (typeof books)[number]) => Boolean(book.data.take || hasSummary(book));
// The filters read as one sentence: "Showing 6 of 95 sci-fi books which are rated and unreviewed."
const filters = {
  genre: [['all', 'any genre'], ...genres.map(([key, label]) => [key, label.toLowerCase()])],
  rating: [['any', 'rated or unrated'], ['yes', 'rated'], ['no', 'unrated']],
  review: [['any', 'reviewed or unreviewed'], ['yes', 'reviewed'], ['no', 'unreviewed']],
};
---

<Base title="Bookshelf" description="What I'm reading: mostly sci-fi, and a bit of everything else.">
  <header class="page-head">
    <h1 class="page-title"><span class="mark">Book</span>shelf</h1>
    <p class="lede">
      Mostly sci-fi, and a bit of everything else. Kept in sync with my <a href={`https://hardcover.app/@${SITE.hardcoverUsername}`}>Hardcover</a>.
    </p>
  </header>

  {
    books.length === 0 ? (
      <p class="empty">No books logged yet.</p>
    ) : (
      <>
        <p class="shelf-filters" id="filters">
          Showing <span class="shelf-count" data-count aria-live="polite">{books.length} of {books.length}</span>{' '}
          <select data-group="genre" aria-label="Genre">
            {filters.genre.map(([value, text]) => (
              <option value={value}>{text}</option>
            ))}
          </select>{' '}
          books which are{' '}
          <select data-group="rating" aria-label="Rating">
            {filters.rating.map(([value, text]) => (
              <option value={value}>{text}</option>
            ))}
          </select>{' '}
          and{' '}
          <select data-group="review" aria-label="Review">
            {filters.review.map(([value, text]) => (
              <option value={value}>{text}</option>
            ))}
          </select>.{' '}
          <button type="button" class="shelf-clear" data-clear hidden>
            Clear filters
          </button>
        </p>
        <div class="shelf-head mono" aria-hidden="true">
          <span class="shelf-book">Book</span>
          <span class="shelf-genre">Genre</span>
          <span class="shelf-when">Read</span>
          <span class="shelf-rating">Rating</span>
          <span class="shelf-link" />
        </div>
        <ul class="shelf" id="books">
          {books.map((book) => {
            const d = book.data;
            return (
              <li data-genre={d.genre} data-review={isReviewed(book) ? 'yes' : 'no'} data-rating={d.rating ? 'yes' : 'no'}>
                <div class="shelf-book">
                  <BookCover cover={d.cover} />
                  <div>
                    <h2>{hasSummary(book) ? <a href={bookHref(book)}>{d.title}</a> : d.title}</h2>
                    <p class="byline">
                      {d.author}
                      {d.series && <span>{` · ${d.series}`}</span>}
                    </p>
                    {d.take && (
                      <p class="take">
                        <em>“{d.take}”</em>
                        {hasSummary(book) && (
                          <>
                            {' '}
                            <a href={bookHref(book)}>Summary →</a>
                          </>
                        )}
                      </p>
                    )}
                  </div>
                </div>
                <span class="shelf-genre">
                  <a class="pill" href={`?genre=${d.genre}`} data-genre-link={d.genre} aria-label={`Show only ${GENRES[d.genre]} books`}>
                    {GENRES[d.genre]}
                  </a>
                </span>
                <span class={`shelf-when mono${d.status === 'reading' ? ' is-reading' : ''}`}>
                  {d.status === 'reading' ? '● Reading now' : d.finished ? formatDate(d.finished, 'month') : STATUS[d.status]}
                </span>
                <span class={`shelf-rating mono${d.rating ? '' : ' is-empty'}`} aria-label={d.rating ? `${d.rating} out of 5 stars` : 'Not rated'}>
                  {d.rating ? '★'.repeat(d.rating) + '☆'.repeat(5 - d.rating) : '—'}
                </span>
                {d.url ? (
                  <a class="shelf-link" href={d.url} aria-label={`${d.title} on Hardcover`}>
                    <ExternalIcon />
                  </a>
                ) : (
                  <span class="shelf-link" />
                )}
              </li>
            );
          })}
        </ul>
        <p class="empty" data-none hidden>
          No books match these filters. <a href="/bookshelf/">Show all books</a>
        </p>
      </>
    )
  }
</Base>

<script>
  // Filters for genre, review and rating. They combine, and live in the address bar
  // (e.g. ?genre=sci-fi&rating=yes) so a filtered shelf can be linked to.
  type Group = 'genre' | 'review' | 'rating';
  const DEFAULTS: Record<Group, string> = { genre: 'all', review: 'any', rating: 'any' };
  const GROUPS = Object.keys(DEFAULTS) as Group[];

  const selects = [...document.querySelectorAll<HTMLSelectElement>('select[data-group]')];
  const rows = [...document.querySelectorAll<HTMLElement>('#books > li')];
  const counts = [...document.querySelectorAll<HTMLElement>('[data-count]')];
  const none = document.querySelector<HTMLElement>('[data-none]');
  const clear = document.querySelector<HTMLButtonElement>('[data-clear]');
  const filters = document.getElementById('filters');
  const selectFor = (group: Group) => selects.find((s) => s.dataset.group === group);

  // Start from the address bar, ignoring anything that isn't a real option.
  const params = new URLSearchParams(location.search);
  const state = { ...DEFAULTS };
  for (const group of GROUPS) {
    const value = params.get(group);
    if (value && [...(selectFor(group)?.options ?? [])].some((o) => o.value === value)) state[group] = value;
  }

  function apply() {
    for (const group of GROUPS) {
      const select = selectFor(group);
      if (select) {
        select.value = state[group];
        // Mark a filter that's doing something, so it reads as on.
        select.classList.toggle('is-set', state[group] !== DEFAULTS[group]);
      }
    }
    let shown = 0;
    for (const row of rows) {
      const match = GROUPS.every((group) => state[group] === DEFAULTS[group] || row.dataset[group] === state[group]);
      row.hidden = !match;
      if (match) shown++;
    }
    counts.forEach((count) => (count.textContent = `${shown} of ${rows.length}`));
    if (none) none.hidden = shown > 0;
    // "Clear filters" only shows while a filter is on.
    if (clear) clear.hidden = GROUPS.every((group) => state[group] === DEFAULTS[group]);

    const query = new URLSearchParams();
    for (const group of GROUPS) if (state[group] !== DEFAULTS[group]) query.set(group, state[group]);
    const search = query.toString();
    history.replaceState(null, '', search ? `?${search}` : location.pathname);
  }

  selects.forEach((select) =>
    select.addEventListener('change', () => {
      state[select.dataset.group as Group] = select.value;
      apply();
    }),
  );
  clear?.addEventListener('click', () => {
    Object.assign(state, DEFAULTS);
    apply();
  });
  // A book's genre filters the shelf to that genre, and scrolls back up to the filters.
  document.querySelectorAll<HTMLAnchorElement>('[data-genre-link]').forEach((link) =>
    link.addEventListener('click', (event) => {
      event.preventDefault();
      state.genre = link.dataset.genreLink!;
      apply();
      filters?.scrollIntoView({ behavior: 'smooth', block: 'start' });
    }),
  );

  apply();
</script>
