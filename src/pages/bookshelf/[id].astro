---
import { render } from 'astro:content';
import BookCover from '../../components/BookCover.astro';
import Base from '../../layouts/Base.astro';
import { formatDate, GENRES, getBooks, hasSummary } from '../../lib/content';

// Only books with a written summary get their own page.
export async function getStaticPaths() {
  const books = (await getBooks()).filter(hasSummary);
  return books.map((book) => ({ params: { id: book.note!.id }, props: { book } }));
}

const { book } = Astro.props;
const d = book.data;
const { Content } = await render(book.note!);
---

<Base title={`${d.title} by ${d.author}`} description={d.take}>
  <a href="/bookshelf/" class="back mono" style="margin-top: 24px">← Bookshelf</a>
  <header class="book-head">
    <BookCover cover={d.cover} />
    <div>
      <h1 class="page-title">{d.title}</h1>
      <p class="byline">
        by <strong>{d.author}</strong>
        {d.series && <span>{' · '}<em>{d.series}</em></span>}
      </p>
      <div class="meta-row mono">
        <span class="pill">{GENRES[d.genre]}</span>
        {d.status === 'reading' ? <span>Reading now</span> : d.finished && <span>Read {formatDate(d.finished, 'month')}</span>}
        {
          d.rating && (
            <span aria-label={`${d.rating} out of 5 stars`}>
              {'★'.repeat(d.rating)}
              {'☆'.repeat(5 - d.rating)}
            </span>
          )
        }
        {d.url && <a href={d.url}>Goodreads ↗</a>}
      </div>
      {d.take && <p class="lede">{d.take}</p>}
    </div>
  </header>
  <article class="summary-card">
    <h2><span class="mark">My summary</span></h2>
    <div class="prose">
      <Content />
    </div>
  </article>
</Base>
