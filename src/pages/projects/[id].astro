---
import EntryPage from '../../components/EntryPage.astro';
import { getProjects } from '../../lib/content';

export async function getStaticPaths() {
  const projects = await getProjects();
  return projects.map((entry, i) => ({
    params: { id: entry.project.id },
    props: { entry, prev: projects[i - 1]?.project, next: projects[i + 1]?.project },
  }));
}

const { entry, prev, next } = Astro.props;
---

<EntryPage entry={entry.project} updates={entry.updates} prev={prev} next={next} />
