---
import EntryPage from '../../components/EntryPage.astro';
import { getHoles } from '../../lib/content';

export async function getStaticPaths() {
  const holes = await getHoles();
  return holes.map((entry, i) => ({
    params: { id: entry.hole.id },
    props: { entry, prev: holes[i - 1]?.hole, next: holes[i + 1]?.hole },
  }));
}

const { entry, prev, next } = Astro.props;
---

<EntryPage entry={entry.hole} updates={entry.updates} prev={prev} next={next} />
